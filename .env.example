DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Production: HTTPS APP_URL and matching NEXTAUTH_URL (or omit NEXTAUTH_URL).
# Trusted ingress must OVERWRITE this single-IP header, not append client input.
# Required in production; omit locally to use one shared development bucket.
RATE_LIMIT_IP_HEADER=

# Development defaults to mock. Production must explicitly select a provider.
NOTIFICATION_PROVIDER=mock
REMINDER_PUBLIC_BASE_URL=http://localhost:3000
MAX_REMINDER_ATTEMPTS=3
PROCESSING_STALE_AFTER_MINUTES=5
REMINDER_RETRY_SECONDS=60
# Server-only. At least 32 random characters; never NEXT_PUBLIC_.
CRON_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# HTTPS canonical public URL, no query string. Optional: derived from public base.
TWILIO_STATUS_CALLBACK_URL=
TWILIO_TEMPLATE_FIRST_REMINDER=
TWILIO_TEMPLATE_FINAL_REMINDER=
