generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  BARBER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id             String                 @id @default(cuid())
  name           String
  email          String                 @unique
  passwordHash   String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  memberships    BarbershopMembership[]
  barberProfiles Barber[]
}

model Barbershop {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  phone          String?
  email          String?
  address        String?
  timezone       String                   @default("America/Santiago")
  currency       String                   @default("CLP")
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    BarbershopMembership[]
  barbers        Barber[]
  services       Service[]
  customers      Customer[]
  appointments   Appointment[]
  availabilities BarberAvailability[]
  barberBreaks   BarberBreak[]
  barberBlocks   BarberBlock[]
  businessHours  BarbershopBusinessHour[]
  blockReasons   BlockReason[]
  sales          Sale[]
}

model Customer {
  id           String        @id @default(cuid())
  barbershopId String
  name         String
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  sales        Sale[]

  @@index([barbershopId])
  @@index([barbershopId, name])
}

enum OnlinePaymentPolicy {
  NONE
  OPTIONAL
  FULL
  DEPOSIT
}

enum AppointmentSource {
  INTERNAL
  ONLINE
}

model Service {
  id              String        @id @default(cuid())
  barbershopId    String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal       @db.Decimal(12, 2)
  isOnlineBookingEnabled Boolean @default(false)
  onlinePaymentPolicy OnlinePaymentPolicy @default(NONE)
  depositAmount Decimal? @db.Decimal(12, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  barbershop      Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  saleItems       SaleItem[]

  @@index([barbershopId])
}

model BarbershopMembership {
  id           String         @id @default(cuid())
  userId       String
  barbershopId String
  role         MembershipRole
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@index([barbershopId])
}

model Barber {
  id             String               @id @default(cuid())
  barbershopId   String
  userId         String?
  name           String
  phone          String?
  email          String?
  commissionRate Decimal              @default(0) @db.Decimal(5, 2)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  barbershop     Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  availabilities BarberAvailability[]
  breaks         BarberBreak[]
  blocks         BarberBlock[]
  sales          Sale[]
  commissions    Commission[]

  @@index([barbershopId])
  @@index([userId])
}

model BarberAvailability {
  id           String     @id @default(cuid())
  barbershopId String
  barberId     String
  dayOfWeek    DayOfWeek
  startMinute  Int
  endMinute    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barbershopId, barberId, dayOfWeek])
  @@index([barberId, dayOfWeek, startMinute])
}

model BarberBlock {
  id           String      @id @default(cuid())
  barbershopId String
  barberId     String
  startsAt     DateTime
  endsAt       DateTime
  reasonId     String
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  reason       BlockReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  @@index([barbershopId, startsAt])
  @@index([barbershopId, barberId, startsAt])
  @@index([barberId, startsAt, endsAt])
  @@index([reasonId])
}

model BarbershopBusinessHour {
  id           String     @id @default(cuid())
  barbershopId String
  dayOfWeek    DayOfWeek
  opensMinute  Int
  closesMinute Int
  isClosed     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
  @@index([barbershopId])
}

model BlockReason {
  id           String        @id @default(cuid())
  barbershopId String
  name         String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  blocks       BarberBlock[]

  @@unique([barbershopId, name])
  @@index([barbershopId, isActive])
}

model BarberBreak {
  id           String     @id @default(cuid())
  barbershopId String
  barberId     String
  dayOfWeek    DayOfWeek
  startMinute  Int
  endMinute    Int
  label        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barbershopId, barberId, dayOfWeek])
  @@index([barberId, dayOfWeek, startMinute])
}

model Appointment {
  id           String            @id @default(cuid())
  barbershopId String
  barberId     String
  customerId   String
  serviceId    String
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(SCHEDULED)
  source       AppointmentSource @default(INTERNAL)
  price        Decimal           @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  barbershop   Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber            @relation(fields: [barberId], references: [id], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sale         Sale?

  @@index([barbershopId, startsAt])
  @@index([barbershopId, barberId, startsAt])
  @@index([barberId, startsAt, endsAt])
}

model Sale {
  id             String       @id @default(cuid())
  barbershopId   String
  appointmentId  String?      @unique
  customerId     String?
  barberId       String
  customerName   String
  barberName     String
  currency       String
  subtotal       Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  status         SaleStatus   @default(COMPLETED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  barbershop     Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  barber         Barber       @relation(fields: [barberId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]
  commission     Commission?

  @@unique([id, barbershopId])
  @@index([barbershopId, createdAt])
  @@index([barberId])
  @@index([customerId])
}

model SaleItem {
  id           String   @id @default(cuid())
  barbershopId String
  saleId       String
  serviceId    String?
  description  String
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  sale         Sale     @relation(fields: [saleId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([barbershopId, saleId])
  @@index([serviceId])
}

model Payment {
  id           String        @id @default(cuid())
  barbershopId String
  saleId       String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  sale         Sale          @relation(fields: [saleId, barbershopId], references: [id, barbershopId], onDelete: Restrict)

  @@index([barbershopId, saleId])
}

model Commission {
  id           String   @id @default(cuid())
  barbershopId String
  saleId       String   @unique
  barberId     String
  rate         Decimal  @db.Decimal(5, 2)
  baseAmount   Decimal  @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  sale         Sale     @relation(fields: [saleId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  barber       Barber   @relation(fields: [barberId], references: [id], onDelete: Restrict)

  @@unique([saleId, barbershopId])
  @@index([barbershopId, barberId, createdAt])
}
